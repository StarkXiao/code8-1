{
  "name": "@froa/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:new": "node scripts/new-migration.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "db:push": "node scripts/prisma-cli.mjs db push",
    "db:validate": "node scripts/prisma-cli.mjs validate",
    "backup": "node scripts/backup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@froa/shared": "*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
