# ============================================================
# 家庭食谱口述整理器 - 环境变量
# 复制为 .env 即可运行：cp .env.example .env
# 默认值全部指向本地零依赖方案，无需任何外部服务
# ============================================================

# ---------- 服务 ----------
PORT=4000
# 前端开发服务器地址，用于 CORS 白名单
WEB_ORIGIN=http://localhost:5173
# 前端开发服务器端口（被占用时会直接报错，而不是悄悄换端口）
WEB_DEV_PORT=5173
# 开发期前端把 /api 与 /ws 代理到这里
API_PROXY_TARGET=http://127.0.0.1:4000
NODE_ENV=development
# 服务端静态托管的 web 构建产物目录（相对仓库根）
WEB_DIST_DIR=apps/web/dist

# ---------- 数据库 ----------
# SQLite：路径相对于仓库根目录（origin/）解析
DATABASE_URL="file:./data/app.db"
# 生产可切换 PostgreSQL，例如：
# DATABASE_URL="postgresql://froa:froa@localhost:5432/froa"

# ---------- 鉴权 ----------
JWT_SECRET=change-me-in-production-this-is-a-dev-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- 音频存储 ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./data/audio
# 单文件上传上限（MB）
MAX_UPLOAD_MB=100

# ---------- 语音转写 ----------
# manual（默认，纯人工，零外部依赖） | whisper-local | openai
ASR_PROVIDER=manual
# ASR_PROVIDER=openai 时需要：
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# ASR_PROVIDER=whisper-local 时需要：
# WHISPER_BIN=whisper
# WHISPER_MODEL=base

# ---------- 备份 ----------
BACKUP_DIR=./data/backups

# ---------- 其他 ----------
# 音频孤儿文件与缺失文件巡检间隔（分钟），0 表示关闭
INTEGRITY_SCAN_INTERVAL_MIN=0
